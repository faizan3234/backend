# ============================================================
# RELIV CLOUD PAYMENT BRIDGE
# ============================================================

NODE_ENV=production

# Node should eventually sit behind a HTTPS reverse proxy.
HOST=127.0.0.1
PORT=10000

# Browser origin(s), comma separated
ALLOWED_ORIGINS=https://reliv7.vercel.app

# Razorpay CLOUD credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# File paths
PRIVATE_KEY_PATH=./private-key.pem
DATABASE_PATH=./bridge.db

# Payment V2 Configuration (Zero-Internet Kiosk QR Protocol)
PAYMENT_V2_CLOUD_PRIVATE_KEY_PATH=./payment-v2-cloud-private-key.pem
PAYMENT_V2_KIOSK_PUBLIC_KEY_PATH=./payment-v2-kiosk-public-key.pem
PAYMENT_V2_CODE_ENCRYPTION_SECRET=
