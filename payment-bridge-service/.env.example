# Payment Bridge Service Environment Variables

# Razorpay credentials (REQUIRED)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Server configuration
PORT=3001

# SECURITY NOTES:
# 1. This service MUST have Internet access to verify payments with Razorpay API
# 2. The private key (private-key.pem) must NEVER be deployed to the Raspberry Pi
# 3. Only the public key (public-key.pem) should be on the Pi
# 4. This service can be deployed to:
#    - Cloud platform (Vercel, AWS Lambda, Google Cloud Run)
#    - VPS with public IP
#    - Same Pi but in a separate isolated process with Internet access
