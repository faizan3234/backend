# Reliv Raspberry Pi Kiosk Backend Environment Configuration
KIOSK_ID=RELIV-001
KIOSK_HOST=192.168.50.1
KIOSK_PORT=5000
PORT=5000
HOST=0.0.0.0
BLE_BACKEND_URL=http://127.0.0.1:5001

# Comma-separated extra HTTPS origins allowed as returnUrl redirect destinations.
# The production baseline (*.reliv.in) and reliv7.vercel.app are always included.
# Add staging/preview domains here without needing a code deploy.
# ALLOWED_RETURN_ORIGINS=https://reliv7.vercel.app,https://staging.reliv.in

# Payment V2 Configuration (Offline Kiosk Transport)
PAYMENT_V2_CODE_PEPPER=
PAYMENT_V2_TTL_SECONDS=300
PAYMENT_V2_MAX_ATTEMPTS=5
PAYMENT_V2_KIOSK_ID=RELIV-001
PAYMENT_V2_KIOSK_SIGNING_PRIVATE_KEY_PATH=./config/payment-v2-kiosk-private-key.pem
PAYMENT_V2_CLOUD_ENCRYPTION_PUBLIC_KEY_PATH=./config/payment-v2-cloud-encryption-public-key.pem
